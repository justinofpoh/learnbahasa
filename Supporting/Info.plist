<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Learn Bahasa listens when you speak your replies in a chat, on your iPhone only.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Learn Bahasa turns your spoken Indonesian into text on your iPhone to check your reply.</string>
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.justinpoh.bahasa</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bahasa</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
